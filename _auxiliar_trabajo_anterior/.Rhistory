}
control_H <- function(H, K) {
c(simetria = max(abs(H - t(H))), idempotencia = max(abs(H %*% H - H)), traza = abs(sum(diag(H)) - K))
}
# R04: ECM, VC y suma de VCG de clase (215-305). Se agregan cuadrados
# por tiempo mediante Y'Y: misma SSE que formar todos los residuos, menor coste.
criterios <- function(Y, tiempo, Ks) {
stopifnot(is.matrix(Y), all(is.finite(Y)), ncol(Y) == length(tiempo))
G <- crossprod(Y); n <- ncol(Y); N <- nrow(Y)
do.call(rbind, lapply(Ks, function(K) {
P <- base_bspline(tiempo, K)
if (K >= n || qr(P)$rank != K) stop("K no estimable")
mapa <- solve(crossprod(P), t(P)); h <- rowSums(P * t(mapa))
if (any(1 - h < 1e-10)) stop("VC indefinida: apalancamiento unitario")
T <- G %*% t(mapa)
# diag((I-H) G (I-H)') = SSE por tiempo, sumada sobre las N curvas.
sse_t <- pmax(0, diag(G) - 2 * rowSums(P * T) + rowSums((P %*% (mapa %*% T)) * P))
data.frame(K = K, ECM = sum(sse_t) / (N * n), VC = sum(sse_t / (1 - h)^2) / (N * n),
VCG = n * sum(sse_t) / (n - K)^2)
}))
}
leer_matriz <- function(archivo, n_id) {
if (!file.exists(archivo)) stop("Falta entrada preparada: ", archivo)
conexion <- if (grepl("gz$", archivo)) gzfile(archivo, open = "rt") else file(archivo, open = "rt")
on.exit(close(conexion))
datos <- read.csv(conexion, check.names = FALSE, colClasses = c("character", rep(NA, n_id - 1L)))
Y <- as.matrix(datos[, -(seq_len(n_id)), drop = FALSE]); storage.mode(Y) <- "double"
claves <- datos[, seq_len(n_id), drop = FALSE]
if (anyDuplicated(claves)) stop("Claves duplicadas en ", archivo)
list(id = claves, Y = Y, tiempos = names(datos)[-seq_len(n_id)])
}
guardar_csv <- function(x, nombre) write.csv(x, file.path(SALIDA, nombre), row.names = FALSE, na = "")
# El año se obtiene por nombre de campo y esquema, nunca por posición inferida.
anios_claves <- function(id, fuente) {
esquema <- if (fuente == "estaciones") c("STATION_ID", "YEAR") else c("anio", "fila", "col")
if (!identical(names(id), esquema) || anyNA(id) || anyDuplicated(id))
stop("Esquema, claves ausentes o duplicadas: ", fuente)
texto <- as.character(id[[if (fuente == "estaciones") "YEAR" else "anio"]])
if (any(!grepl("^[0-9]{4}$", texto))) stop("Año no entero de cuatro dígitos: ", fuente)
as.integer(texto)
}
filtrar_periodo <- function(datos, fuente) {
anio <- anios_claves(datos$id, fuente)
if (nrow(datos$id) != nrow(datos$Y)) stop("Claves y matriz desalineadas")
conservar <- anio %in% ANIOS
if (!any(conservar)) stop("No hay curvas en 1981–2003: ", fuente)
datos$id <- datos$id[conservar, , drop = FALSE]
datos$Y <- datos$Y[conservar, , drop = FALSE]
datos
}
cobertura_periodo <- function(datos, fuente) {
anio <- anios_claves(datos$id, fuente)
if (any(!anio %in% ANIOS)) stop("Cobertura fuera de ventana normativa")
sitios <- datos$id[, setdiff(names(datos$id), c("YEAR", "anio")), drop = FALSE]
clave <- function(x) do.call(paste, c(x, sep = ":"))
catalogo <- unique(sitios); cod <- clave(sitios)
panel <- catalogo[rep(seq_len(nrow(catalogo)), each = length(ANIOS)), , drop = FALSE]
panel$anio <- rep(ANIOS, nrow(catalogo))
presente <- paste(clave(panel[, names(catalogo), drop = FALSE]), panel$anio) %in% paste(cod, anio)
anual <- do.call(rbind, lapply(ANIOS, function(a) {
M <- datos$Y[anio == a, , drop = FALSE]
data.frame(anio = a, curvas = nrow(M), sitios = length(unique(cod[anio == a])),
sitios_sin_curva = nrow(catalogo) - nrow(M), completas = sum(rowSums(is.na(M)) == 0),
incompletas = sum(rowSums(is.na(M)) > 0), valores_faltantes = sum(is.na(M)))
}))
list(anual = anual, ausentes = panel[!presente, , drop = FALSE])
}
validar_oni <- function(oni) {
if (!all(c("anio", "fase") %in% names(oni)) || anyNA(oni$anio) ||
any(!grepl("^[0-9]{4}$", as.character(oni$anio))) || anyDuplicated(oni$anio))
stop("Esquema/años ONI inválidos")
oni <- oni[oni$anio %in% ANIOS, , drop = FALSE]
if (!setequal(oni$anio, ANIOS) || anyNA(oni$fase) || any(!nzchar(oni$fase)))
stop("ONI incompleto en 1981–2003")
oni[order(oni$anio), , drop = FALSE]
}
# Solo se repite el dibujo, nunca la selección, el ajuste ni el EDA.
exportar_grafico <- function(nombre, dibujar, width = 11, height = 4,
mostrar = getOption("lluvia.mostrar", interactive())) {
guardar <- function() {
pdf(file.path(SALIDA, nombre), width = width, height = height)
dispositivo <- dev.cur()
on.exit(dev.off(dispositivo))
dibujar()
}
guardar()
if (getOption("lluvia.png", FALSE)) {
png(sub("\\.pdf$", ".png", file.path(SALIDA, nombre)),
width = width, height = height, units = "in", res = 180)
dispositivo_png <- dev.cur()
tryCatch(dibujar(), finally = dev.off(dispositivo_png))
}
if (mostrar) {
if (dev.cur() == 1L || names(dev.cur()) == "pdf") dev.new(width = width, height = height)
parametros <- par(no.readonly = TRUE)
on.exit(par(parametros), add = TRUE)
dibujar()
}
message("  Figura guardada: ", file.path(SALIDA, nombre),
if (mostrar) " (también dibujada en el dispositivo activo)" else " (sin visualización)")
invisible(NULL)
}
mostrar_tabla <- function(x, titulo, filas = 6L) {
cat("\n", titulo, " — ", nrow(x), " filas; mostrando hasta ", filas, "\n", sep = "")
print(utils::head(x, filas), row.names = FALSE)
invisible(x)
}
mapa_calor <- function(tiempo, z, titulo, unidad, limites = range(z)) {
colores <- hcl.colors(64, "Blue-Red 3")
layout(matrix(1:2, 1), widths = c(5, 1))
par(mar = c(4, 4, 3, 1))
image(tiempo, tiempo, z, zlim = limites, col = colores,
main = titulo, xlab = "Día s", ylab = "Día t")
par(mar = c(4, 0, 3, 4))
escala <- seq(limites[1], limites[2], length.out = 65)
image(c(0, 1), escala, matrix(rep(escala, each = 2), nrow = 2),
col = colores, zlim = limites, axes = FALSE, xlab = "", ylab = "")
axis(4, at = pretty(limites), las = 1, cex.axis = .8)
mtext(unidad, side = 3, cex = .65)
box()
layout(1)
}
# Una tabla por petición; no abre ventanas automáticamente al ejecutar el análisis.
ver_tabla <- function(nombre = "diagnosticos_EDA.csv", abrir = interactive()) {
if (length(nombre) != 1L || basename(nombre) != nombre || !grepl("\\.csv$", nombre))
stop("Indique el nombre de un CSV dentro de SALIDA")
tabla <- read.csv(file.path(SALIDA, nombre), check.names = FALSE)
mostrar_tabla(tabla, nombre)
if (abrir && interactive()) utils::View(tabla, title = nombre)
invisible(tabla)
}
presentar_seleccion <- function(seleccion, nombre) {
guardar_csv(seleccion, paste0("seleccion_K_", nombre, ".csv"))
mostrar_tabla(do.call(rbind, lapply(c("ECM", "VC", "VCG"), function(crit) {
j <- which.min(seleccion[[crit]])
data.frame(criterio = crit, K = seleccion$K[j], valor = seleccion[[crit]][j])
})), paste(nombre, "mínimos; VCG decide"))
for (crit in c("ECM", "VC", "VCG")) {
exportar_grafico(paste0("criterio_", crit, "_", nombre, ".pdf"), function() {
plot(seleccion$K, seleccion[[crit]], type = "b", pch = 16, cex = .5, col = 4,
main = paste(nombre, "criterio", crit), xlab = "K: número de funciones base", ylab = crit)
j <- which.min(seleccion[[crit]])
abline(v = seleccion$K[j], col = 2, lty = 2)
legend("topright", paste("Mínimo: K =", seleccion$K[j]), col = 2, lty = 2, bty = "n")
})
}
# PDF compatible para lectores previos; los tres PNG son individuales.
exportar_grafico(paste0("seleccion_K_", nombre, ".pdf"), function() {
par(mfrow = c(1, 3))
for (crit in c("ECM", "VC", "VCG"))
plot(seleccion$K, seleccion[[crit]], type = "l", main = crit, xlab = "K", ylab = crit)
})
}
construir_fuente <- function(datos, tiempo, Ks, nombre, escala, seleccion = NULL) {
# 1. ECM/VC/VCG (clase C 240-305): elegir K antes del ajuste definitivo.
Y <- datos$Y; completas <- rowSums(is.na(Y)) == 0L
message("[Construcción / ", nombre, "] Selección de K por ECM, VC y VCG...")
if (!any(completas)) stop("No hay curvas completas para elegir K")
nueva_seleccion <- is.null(seleccion)
if (nueva_seleccion) seleccion <- criterios(Y[completas, , drop = FALSE], tiempo, Ks)
K <- seleccion$K[which.min(seleccion$VCG)]; Phi <- base_bspline(tiempo, K)
if (nueva_seleccion) presentar_seleccion(seleccion, nombre)
message("[Construcción / ", nombre, "] Ajuste MCO, controles H, residuos y banda...")
# 2. Phi, coeficientes, y2cMap y H (clase C 73-105); completas en bloque.
C <- matrix(NA_real_, nrow(Y), K); sigma2 <- rep(NA_real_, nrow(Y))
mapa <- solve(crossprod(Phi), t(Phi)); H <- Phi %*% mapa
C[completas, ] <- Y[completas, , drop = FALSE] %*% t(mapa)
Res <- Y[completas, , drop = FALSE] - C[completas, , drop = FALSE] %*% t(Phi)
sigma2[completas] <- rowSums(Res^2) / (length(tiempo) - K)
diag_H <- control_H(H, K)
for (i in which(!completas)) {
ajuste <- ajuste_mco(Y[i, ], Phi)
C[i, ] <- ajuste$coef; sigma2[i] <- ajuste$sigma2
diag_H <- pmax(diag_H, control_H(ajuste$H, K))
}
stopifnot(all(diag_H < 1e-8), all(is.finite(C)))
colnames(C) <- paste0("c", seq_len(K))
guardar_csv(cbind(datos$id, C, sigma2 = sigma2, n_observado = rowSums(!is.na(Y))), paste0("coef_", nombre, ".csv"))
guardar_csv(data.frame(tiempo = tiempo, Phi), paste0("Phi_", nombre, ".csv"))
# 3. Residuos y banda puntual (clase C 350-387), solo completas para Sigma_res.
Sigma_res <- crossprod(Res) / nrow(Res) # PDF Construcción p. física 33: N^-1 sum e_i e_i'
guardar_csv(Sigma_res, paste0("cov_residual_", nombre, ".csv"))
guardar_csv(data.frame(control = names(diag_H), error_max = diag_H), paste0("controles_H_", nombre, ".csv"))
# R07: banda puntual sigma²I, sin extensión estacional no localizada en clase.
i <- which(completas)[1L]; ajuste <- ajuste_mco(Y[i, ], Phi)
diario <- base_bspline(1:365, K); curva <- as.vector(diario %*% C[i, ])
ee <- sqrt(sigma2[i] * rowSums((diario %*% ajuste$mapa)^2))
guardar_csv(data.frame(datos$id[rep(i, 365), , drop = FALSE], dia = 1:365,
curva = curva, ee = ee, inferior = curva - 2 * ee, superior = curva + 2 * ee),
paste0("banda_ejemplo_", nombre, ".csv"))
exportar_grafico(paste0("curva_banda_residuos_", nombre, ".pdf"), function() {
plot(tiempo, Y[i, ], xlab = "Día", ylab = escala, main = paste(nombre, "banda puntual"),
ylim = range(c(Y[i, ], curva - 2 * ee, curva + 2 * ee)))
lines(1:365, curva, col = 4); lines(1:365, curva - 2 * ee, lty = 2); lines(1:365, curva + 2 * ee, lty = 2)
legend("topright", c("Observado", "Ajuste MCO", "Banda puntual ±2 EE"),
col = c(1, 4, 1), pch = c(1, NA, NA), lty = c(NA, 1, 2), bty = "n", cex = .8)
}, width = 10)
exportar_grafico(paste0("residual_", nombre, ".pdf"), function() {
mapa_calor(tiempo, Sigma_res, paste("Momento residual:", nombre), paste0("Cuadrado de: ", escala))
}, width = 7, height = 5)
mostrar_tabla(data.frame(control = names(diag_H), error_max = diag_H), paste(nombre, "controles de S"))
cat(nombre, ":", nrow(Y), "curvas; completas", sum(completas), "; K VCG =", K, "\n")
list(id = datos$id, coef = C, K = K, tiempo = tiempo, sigma2 = sigma2,
observados = !is.na(Y), rango = RANGO, orden = ORDEN,
escala = escala,
seleccion = seleccion, completas = completas)
}
# AUXILIARES DE EDA ----
# E05: definición FM y MBD inclusivas (PDF EDA p. 53). Acumular por
# tiempo evita almacenar dos matrices de rangos de todas las curvas satelitales.
# depth.FM de clase transforma la profundidad univariada: 2 * FM_pdf - 1.
# Media discreta en malla uniforme, igual que depth.FM; no integral sin normalizar.
profundidades <- function(Y) {
if (!is.matrix(Y) || nrow(Y) < 2L || ncol(Y) < 1L || !all(is.finite(Y))) stop("Profundidad requiere >=2 curvas finitas")
N <- nrow(Y); fm <- mbd <- numeric(N)
for (j in seq_len(ncol(Y))) {
r <- rank(Y[, j], ties.method = "max")
L <- rank(Y[, j], ties.method = "min") - 1; U <- N - r
fm <- fm + 1 - abs(.5 - r / N)
mbd <- mbd + 1 - (L * (L - 1) + U * (U - 1)) / (N * (N - 1))
}
list(FM = 2 * fm / ncol(Y) - 1, FM_pdf = fm / ncol(Y), MBD = mbd / ncol(Y))
}
centralidad_FM <- function(Y, prof) {
# Script E 450-466: depth.FM incluye todos los empates del cuantil de recorte.
incluidas <- which(prof >= quantile(prof, .25, names = FALSE))
list(mediana = Y[which.max(prof), ], recortada = colMeans(Y[incluidas, , drop = FALSE]),
incluidas = incluidas)
}
boxplot_funcional <- function(Y, prof = profundidades(Y)$MBD) {
centro <- order(-prof)[seq_len(ceiling(nrow(Y) / 2))]
lo <- apply(Y[centro, , drop = FALSE], 2, min); hi <- apply(Y[centro, , drop = FALSE], 2, max)
inf <- lo - 1.5 * (hi - lo); sup <- hi + 1.5 * (hi - lo)
# La igualdad permanece dentro de la cerca; solo excederla define una atípica.
atip <- apply(Y, 1, function(y) any(y < inf | y > sup))
buenas <- Y[!atip, , drop = FALSE]
bigote_inferior <- if (nrow(buenas)) apply(buenas, 2, min) else rep(NA_real_, ncol(Y))
bigote_superior <- if (nrow(buenas)) apply(buenas, 2, max) else rep(NA_real_, ncol(Y))
list(lo = lo, hi = hi, inf = inf, sup = sup, atip = atip, mediana = Y[which.max(prof), ],
bigote_inferior = bigote_inferior, bigote_superior = bigote_superior)
}
iniciar_eda <- function(obj, nombre, oni) {
list2env(list(obj = obj, nombre = nombre, oni = oni), parent = environment(iniciar_eda))
}
# Cada paso evalúa en un entorno explícito: conserva matrices para inspección,
# sin duplicar las fórmulas en la vía editor y la vía batch.
eda_momentos <- function(estado) evalq({
message("[EDA / ", nombre, "] Media, dispersión, covarianza y derivada...")
# Orden docente E: media -> varianza/DE/CV -> covarianza -> derivada -> profundidad.
# Y contiene tasas heredadas, no acumulados: su derivada es cambio de tasa.
C <- obj$coef; P <- base_bspline(1:365, obj$K); D <- deriv_base(1:365, obj$K)
unidad <- obj$escala
Y <- C %*% t(P); mu <- as.vector(P %*% colMeans(C)); dmu <- as.vector(D %*% colMeans(C))
varianza <- colSums(sweep(Y, 2, mu)^2) / (nrow(Y) - 1)
Cc <- sweep(C, 2, colMeans(C)); covar <- P %*% (crossprod(Cc) / (nrow(C) - 1)) %*% t(P)
correlacion <- cov2cor(covar)
stopifnot(max(abs(mu - colMeans(Y))) < 1e-9, max(abs(diag(covar) - varianza)) < 1e-8)
# E01: esta librería solo se consulta en EDA, nunca para construir las curvas.
error_fda <- NA_real_; estado_fda <- "PENDIENTE: fda no instalado"
if (requireNamespace("fda", quietly = TRUE)) {
base <- fda::create.bspline.basis(RANGO, nbasis = obj$K, norder = ORDEN)
fd <- fda::fd(t(C), base)
error_fda <- max(abs(mu - as.vector(fda::eval.fd(1:365, fda::mean.fd(fd)))))
stopifnot(error_fda < 1e-9); estado_fda <- "OK"
}
guardar_csv(data.frame(fuente = nombre, estado = estado_fda, error_max = error_fda), paste0("verificacion_media_libreria_", nombre, ".csv"))
resumen <- data.frame(dia = 1:365, media = mu, varianza = varianza, de = sqrt(varianza),
cv = ifelse(abs(mu) > sqrt(.Machine$double.eps), sqrt(varianza) / mu, NA), derivada_media = dmu)
guardar_csv(covar, paste0("covarianza_", nombre, ".csv"))
guardar_csv(correlacion, paste0("correlacion_", nombre, ".csv"))
mostrar_tabla(resumen, paste(nombre, "momentos diarios antes de calcular profundidad"))
exportar_grafico(paste0("media_", nombre, ".pdf"), function() {
plot(1:365, mu, type = "l", col = 4, lwd = 2, main = paste("Media funcional:", nombre),
xlab = "Día anual", ylab = unidad)
legend("topright", "Media de todas las curvas ajustadas", col = 4, lty = 1, bty = "n")
})
invisible(NULL)
}, estado)
eda_profundidad <- function(estado) evalq({
message("[EDA / ", nombre, "] Profundidades FM/MBD y boxplot funcional...")
pr <- profundidades(Y); bx <- boxplot_funcional(Y, pr$MBD)
central <- centralidad_FM(Y, pr$FM)
# E06: verificar la regla completa con fbplot, reutilizando la profundidad inclusiva.
# Su algoritmo MBD por rangos medios no coincide con bandas inclusivas si hay empates.
if (requireNamespace("fda", quietly = TRUE) && any(!bx$atip)) {
ref <- fda::fbplot(t(Y), 1:365, depth = pr$MBD, plot = FALSE)
stopifnot(identical(as.integer(which(bx$atip)), as.integer(ref$outpoint)))
}
resumen <- data.frame(dia = 1:365, media = mu, varianza = varianza, de = sqrt(varianza),
cv = ifelse(abs(mu) > sqrt(.Machine$double.eps), sqrt(varianza) / mu, NA),
derivada_media = dmu, mediana_FM = central$mediana, mediana_MBD = bx$mediana, media_recortada_FM_25 = central$recortada)
guardar_csv(resumen, paste0("resumen_", nombre, ".csv"))
mostrar_tabla(resumen, paste(nombre, "resumen diario"))
guardar_csv(covar, paste0("covarianza_", nombre, ".csv")); guardar_csv(correlacion, paste0("correlacion_", nombre, ".csv"))
guardar_csv(cbind(obj$id, FM = pr$FM, FM_pdf = pr$FM_pdf, MBD = pr$MBD, atipica = bx$atip,
incluida_recorte_FM = seq_len(nrow(Y)) %in% central$incluidas), paste0("profundidades_", nombre, ".csv"))
guardar_csv(cbind(obj$id, FM = pr$FM, MBD = pr$MBD)[bx$atip, , drop = FALSE], paste0("atipicas_", nombre, ".csv"))
guardar_csv(data.frame(dia = 1:365, inferior_central = bx$lo, superior_central = bx$hi,
limite_inferior = bx$inf, limite_superior = bx$sup,
bigote_inferior = bx$bigote_inferior, bigote_superior = bx$bigote_superior), paste0("boxplot_", nombre, ".csv"))
# Se conserva solo la derivada de clase. No se renombran máximos de pendiente
# como fechas meteorológicas de inicio/fin: esa receta no aparece en el material.
exportar_grafico(paste0("EDA_", nombre, ".pdf"), function() {
matplot(1:365, resumen[, c("media", "mediana_FM", "media_recortada_FM_25")], type = "l", lty = 1:3,
col = c(4, 2, 3), lwd = 2, main = paste("Centralidad:", nombre), xlab = "Día", ylab = unidad)
legend("topright", c("Media", "Mediana FM", "Media recortada FM 25 %"),
col = c(4, 2, 3), lty = 1:3, lwd = 2, bty = "n", cex = .8)
})
mostrar_tabla(cbind(obj$id, FM = pr$FM, MBD = pr$MBD, atipica = bx$atip), paste(nombre, "profundidades por curva"))
invisible(NULL)
}, estado)
graficar_boxplot <- function(estado) evalq({
exportar_grafico(paste0("boxplot_", nombre, ".pdf"), function() {
plot(1:365, bx$mediana, type = "n", ylim = range(c(bx$inf, bx$sup, Y[bx$atip, , drop = FALSE])),
main = paste("Boxplot MBD:", sum(bx$atip), "atípicas"), xlab = "Día", ylab = unidad)
polygon(c(1:365, 365:1), c(bx$lo, rev(bx$hi)), col = "plum", border = NA)
lines(1:365, bx$mediana, lwd = 2); lines(1:365, bx$inf, lty = 2); lines(1:365, bx$sup, lty = 2)
lines(1:365, bx$bigote_inferior, col = 4); lines(1:365, bx$bigote_superior, col = 4)
if (any(bx$atip)) matlines(1:365, t(Y[bx$atip, , drop = FALSE]), col = "#cc333333", lty = 1)
legend("topright", c("Región central 50 %", "Mediana MBD", "Límites 1,5", "Bigotes no atípicos", "Atípicas"),
col = c("plum", 1, 1, 4, "#cc3333"), lty = c(NA, 1, 2, 1, 1),
pch = c(15, NA, NA, NA, NA), cex = .75, bty = "n")
}, height = 5, width = 9)
cat(nombre, ":", sum(bx$atip), "atípicas; todas las curvas intervienen en profundidad.\n")
}, estado)
graficar_dispersion <- function(estado) evalq({
mostrar_tabla(resumen[, c("dia", "varianza", "de", "cv")], paste(nombre, "dispersión"))
for (variable in c("varianza", "de", "cv")) {
exportar_grafico(paste0(variable, "_", nombre, ".pdf"), function() {
plot(1:365, resumen[[variable]], type = "l", col = 4, lwd = 2,
main = paste(nombre, variable), xlab = "Día anual",
ylab = switch(variable, varianza = paste0("Cuadrado de: ", unidad), de = unidad, cv = "DE/media (sin unidad)"))
})
}
for (variable in c("covarianza", "correlacion")) {
z <- if (variable == "covarianza") covar else correlacion
exportar_grafico(paste0(variable, "_", nombre, ".pdf"), function() {
mapa_calor(1:365, z, paste(nombre, variable),
if (variable == "correlacion") "Sin unidad" else paste0("Cuadrado de: ", unidad),
limites = if (variable == "correlacion") c(-1, 1) else range(z))
}, width = 7, height = 5)
}
invisible(NULL)
}, estado)
eda_contexto <- function(estado) evalq({
message("[EDA / ", nombre, "] Contexto por grupos y ONI anual...")
anio <- anios_claves(obj$id, nombre)
fase <- oni$fase[match(anio, oni$anio)]
if (anyNA(fase)) stop("Curvas sin clasificación ONI")
ens <- do.call(rbind, lapply(sort(unique(fase[!is.na(fase)])), function(f) {
M <- Y[which(fase == f), , drop = FALSE]
data.frame(fase = f, n_curvas = nrow(M), dia = 1:365, media = colMeans(M))
}))
guardar_csv(ens, paste0("media_ONI_anual_", nombre, ".csv"))
# E07: agrupaciones heredadas del prototipo, rotuladas por su regla,
# sin afirmar pertenencia hidrográfica ni pares estación-píxel.
grupo <- if (nombre == "estaciones") {
ifelse(substr(obj$id[[1]], 1, 2) == "26", "prefijo_26", "otro_prefijo")
} else {
lon <- -77.55 + .05 * (as.numeric(obj$id[[3]]) + .5)
ifelse(lon < -76.8, "longitud_menor_-76.8", "longitud_mayor_igual_-76.8")
}
grupos <- do.call(rbind, lapply(sort(unique(grupo)), function(g) {
M <- Y[grupo == g, , drop = FALSE]
data.frame(grupo = g, n_curvas = nrow(M), dia = 1:365, media = colMeans(M))
}))
guardar_csv(grupos, paste0("media_grupos_descriptivos_", nombre, ".csv"))
for (tipo in c("ONI", "grupos")) {
tabla <- if (tipo == "ONI") ens else grupos
etiqueta <- tabla[[1]]; niveles <- unique(etiqueta)
mostrar_tabla(unique(tabla[, 1:2]), paste(nombre, tipo, "tamaño de grupos"))
exportar_grafico(paste0(tipo, "_", nombre, ".pdf"), function() {
plot(1:365, mu, type = "n", ylim = range(tabla$media), xlab = "Día anual", ylab = unidad,
main = paste(nombre, if (tipo == "ONI") "ONI medio anual heredado" else "Grupos aproximados, no cuencas"))
for (j in seq_along(niveles)) lines(1:365, tabla$media[etiqueta == niveles[j]], col = j, lwd = 2)
legend("topright", niveles, col = seq_along(niveles), lty = 1, bty = "n", cex = .75)
})
}
exportar_grafico(paste0("contexto_", nombre, ".pdf"), function() {
par(mfrow = c(1, 2))
for (tabla in list(grupos, ens)) {
etiqueta <- tabla[[1]]; niveles <- unique(etiqueta)
plot(1:365, mu, type = "n", ylim = range(tabla$media), xlab = "Día", ylab = unidad,
main = if (identical(tabla, grupos)) "Grupos aproximados; no pareados" else "Fase por ONI medio anual (heredada)")
for (i in seq_along(niveles)) lines(1:365, tabla$media[etiqueta == niveles[i]], col = i, lwd = 2)
legend("topright", niveles, col = seq_along(niveles), lty = 1, cex = .7, bty = "n")
}
})
invisible(NULL)
}, estado)
eda_diagnostico <- function(estado) evalq({
diagnostico <- data.frame(fuente = nombre, n = nrow(Y), atipicas = sum(bx$atip), minimo = min(Y),
puntos_negativos = sum(Y < 0), dia_mayor_DE = which.max(varianza), cor_abril_octubre = correlacion[105, 290],
error_media = max(abs(mu - colMeans(Y))), error_diagonal_cov = max(abs(diag(covar) - varianza)),
verificacion_libreria = estado_fda)
invisible(diagnostico)
}, estado)
eda_fuente <- function(obj, nombre, oni) {
estado <- iniciar_eda(obj, nombre, oni)
eda_momentos(estado)
graficar_dispersion(estado)
eda_profundidad(estado)
graficar_boxplot(estado)
if (!is.null(oni)) eda_contexto(estado)
eda_diagnostico(estado)
}
# Lectura de la construcción guardada (también utilizada por la entrada 04).
cargar_construccion <- function() {
if (dir.exists(".Rlib")) .libPaths(c(normalizePath(".Rlib"), .libPaths()))
if (!file.exists(file.path(SALIDA, "construccion.rds"))) stop("Ejecute primero la construcción R")
obj <- readRDS(file.path(SALIDA, "construccion.rds"))
if (!identical(obj$version, VERSION_CONSTRUCCION))
stop("Construcción anterior a la separación temporal: vuelva a ejecutar la Fase 1")
if (!identical(obj$periodo, ANIOS)) stop("Construcción histórica o periodo incorrecto: vuelva a ejecutar la sección CONSTRUCCIÓN FUNCIONAL")
if (!identical(obj$anios_entrenamiento, ANIOS_ENTRENAMIENTO))
stop("La construcción no documenta 1981–1995 como entrenamiento")
for (fuente in c("estaciones", "satelite")) {
anio <- anios_claves(obj[[fuente]]$id, fuente)
if (any(!anio %in% ANIOS) || !setequal(anio, ANIOS)) stop("Años de construcción inválidos: ", fuente)
}
obj
}
# FIN DE PREPARACIÓN ----
# CONSTRUCCIÓN FUNCIONAL ----
options(lluvia.png = TRUE, lluvia.mostrar = interactive())
dir.create(SALIDA, showWarnings = FALSE)
if (dir.exists(".Rlib")) .libPaths(c(normalizePath(".Rlib"), .libPaths()))
cat("Preparación lista. Ventana:", min(ANIOS), "a", max(ANIOS), "\n")
cat("Fase 1: construcción funcional. K se elige SOLO con",
min(ANIOS_ENTRENAMIENTO), "a", max(ANIOS_ENTRENAMIENTO), "\n")
validar_entradas("construccion")
# 1. Leer y filtrar ANTES de seleccionar K ----
est <- leer_matriz("fda_fase1/curvas_estaciones_mm.csv.gz", 2L)
sat <- leer_matriz("fda_fase1/curvas_satelite_mm.csv.gz", 3L)
antes <- c(nrow(est$id), nrow(sat$id))
est <- filtrar_periodo(est, "estaciones")
sat <- filtrar_periodo(sat, "satelite")
ts <- as.numeric(sub("^t", "", sat$tiempos))
stopifnot(identical(as.integer(est$tiempos), 1:365), length(ts) == 72L, all(diff(ts) > 0))
filtro <- data.frame(fuente = c("estaciones", "satelite"), antes = antes,
en_periodo = c(nrow(est$id), nrow(sat$id)),
excluidas_periodo = antes - c(nrow(est$id), nrow(sat$id)))
guardar_csv(filtro, "filtrado_periodo.csv")
mostrar_tabla(filtro, "Datos que realmente entran en la construcción")
mostrar_tabla(cobertura_periodo(est, "estaciones")$anual, "Cobertura: tener años no implica panel completo")
# 2. Mirar los datos discretos antes de suavizarlos (E 28–83) ----
mostrar_tabla(cbind(est$id[1:4, ], est$Y[1:4, 1:5]), "Estaciones: primeras cinco observaciones")
mostrar_tabla(cbind(sat$id[1:4, ], sat$Y[1:4, 1:5]), "Satélite: primeras cinco observaciones")
for (fuente in c("estaciones", "satelite")) {
d <- if (fuente == "estaciones") est else sat
t_obs <- if (fuente == "estaciones") 1:365 else ts
unidad_obs <- if (fuente == "estaciones") "mm/día" else "Escala satelital original (unidad pendiente)"
exportar_grafico(paste0("observados_", fuente, ".pdf"), function() {
matplot(t_obs, t(d$Y[1:4, ]), type = "l", lty = 1, col = 1:4,
main = paste("Observaciones preparadas:", fuente), xlab = "Día anual (calendario heredado)",
ylab = unidad_obs)
legend("topright", apply(d$id[1:4, , drop = FALSE], 1, paste, collapse = " / "),
col = 1:4, lty = 1, cex = .8, bty = "n")
})
}
# 3. Comparar ECM, VC y VCG; VCG decide usando SOLO entrenamiento ----
anio_est <- anios_claves(est$id, "estaciones")
anio_sat <- anios_claves(sat$id, "satelite")
completas_est <- rowSums(is.na(est$Y)) == 0L
completas_sat <- rowSums(is.na(sat$Y)) == 0L
seleccion_K_est <- completas_est & anio_est %in% ANIOS_ENTRENAMIENTO
seleccion_K_sat <- completas_sat & anio_sat %in% ANIOS_ENTRENAMIENTO
if (!any(seleccion_K_est) || !any(seleccion_K_sat))
stop("No hay curvas completas de entrenamiento para seleccionar K")
uso_particiones_K <- rbind(
data.frame(
fuente = "estaciones", particion = c("ENTRENAMIENTO", "VALIDACION", "PRUEBA"),
curvas_totales = as.integer(table(factor(particion_anio(anio_est), levels = c("ENTRENAMIENTO", "VALIDACION", "PRUEBA")))),
curvas_completas = as.integer(table(factor(particion_anio(anio_est[completas_est]), levels = c("ENTRENAMIENTO", "VALIDACION", "PRUEBA")))),
usadas_para_elegir_K = c(sum(seleccion_K_est), 0L, 0L)
),
data.frame(
fuente = "satelite", particion = c("ENTRENAMIENTO", "VALIDACION", "PRUEBA"),
curvas_totales = as.integer(table(factor(particion_anio(anio_sat), levels = c("ENTRENAMIENTO", "VALIDACION", "PRUEBA")))),
curvas_completas = as.integer(table(factor(particion_anio(anio_sat[completas_sat]), levels = c("ENTRENAMIENTO", "VALIDACION", "PRUEBA")))),
usadas_para_elegir_K = c(sum(seleccion_K_sat), 0L, 0L)
)
)
guardar_csv(uso_particiones_K, "trazabilidad_seleccion_K.csv")
mostrar_tabla(uso_particiones_K, "Particiones usadas para seleccionar K", filas = nrow(uso_particiones_K))
seleccion_est <- criterios(est$Y[seleccion_K_est, , drop = FALSE], 1:365, c(4:40, seq(45, 100, 5)))
seleccion_sat <- criterios(sat$Y[seleccion_K_sat, , drop = FALSE], ts, 4:40)
K_est <- seleccion_est$K[which.min(seleccion_est$VCG)]
K_sat <- seleccion_sat$K[which.min(seleccion_sat$VCG)]
presentar_seleccion(seleccion_est, "estaciones")
presentar_seleccion(seleccion_sat, "satelite")
# 4. Ver Phi, mapa y S (C 73–105); base propia Cox-de Boor ----
Phi_est <- base_bspline(1:365, K_est)
Phi_sat <- base_bspline(ts, K_sat)
mapa_est <- solve(crossprod(Phi_est), t(Phi_est))
S_est <- Phi_est %*% mapa_est
mostrar_tabla(data.frame(dia = 1:365, Phi_est), "Phi estaciones: una columna por función base")
print(control_H(S_est, K_est))
for (fuente in c("estaciones", "satelite")) {
K_actual <- if (fuente == "estaciones") K_est else K_sat
exportar_grafico(paste0("bases_", fuente, ".pdf"), function() {
matplot(1:365, base_bspline(1:365, K_actual), type = "l", lty = 1,
main = paste("Base cúbica:", fuente, "K =", K_actual),
xlab = "Día anual", ylab = "Valor de la función base (sin unidad)")
legend("topright", paste0("B", seq_len(K_actual)), col = seq_len(K_actual),
lty = 1, ncol = 2, cex = .75, bty = "n")
})
}
# 5. Ajustar con los K elegidos; bandas y residuos (C 83–105, 350–387) ----
e <- construir_fuente(est, 1:365, seleccion_est$K, "estaciones", "mm/día", seleccion = seleccion_est)
s <- construir_fuente(sat, ts, seleccion_sat$K, "satelite",
"Escala satelital original; unidad y conversión temporal pendientes", seleccion = seleccion_sat)
