# LLUVIA 1981–2003: CONSTRUCCIÓN FUNCIONAL + EDA FUNCIONAL ----
# Abra este archivo y ejecute desde la primera línea con Cmd/Ctrl+Enter o Source.
# La preparación define funciones completas; RStudio ejecuta cada definición
# como una unidad. Continúe después con CONSTRUCCIÓN FUNCIONAL y EDA FUNCIONAL.
# Ejecute desde la primera línea, no desde mitad de una función.
# Las tablas aparecen en consola, los gráficos en Plots y los objetos en Environment.
# Este archivo contiene DOS fases secuenciales:
#   Fase 1. Construcción funcional manual: B-splines, selección de K y coeficientes.
#   Fase 2. EDA funcional: momentos, profundidad, boxplot y contexto descriptivo.
# La Fase 2 reutiliza la construcción guardada por la Fase 1.
# PREPARACIÓN: ejecutar completa antes de los cálculos ----
# Ruta portátil. Prioridad:
# 1) variable de entorno PROYECTO_ANALITICA_DIR;
# 2) carpeta de trabajo actual;
# 3) carpeta del script y su carpeta padre.
ruta_script_actual <- function() {
argumentos <- commandArgs(trailingOnly = FALSE)
archivo <- sub("^--file=", "", argumentos[grepl("^--file=", argumentos)])
if (length(archivo)) return(normalizePath(archivo[1], mustWork = FALSE))
marcos <- sys.frames()
rutas <- unlist(lapply(marcos, function(x) if (!is.null(x$ofile)) x$ofile else NULL))
if (length(rutas)) normalizePath(tail(rutas, 1), mustWork = FALSE) else ""
}
buscar_carpeta_proyecto <- function() {
script <- ruta_script_actual()
candidatos <- c(
Sys.getenv("PROYECTO_ANALITICA_DIR", unset = ""),
getwd(),
if (nzchar(script)) dirname(script) else "",
if (nzchar(script)) dirname(dirname(script)) else ""
)
candidatos <- unique(normalizePath(candidatos[nzchar(candidatos)], mustWork = FALSE))
marcador <- "P_1980_1990.csv"
encontrados <- candidatos[file.exists(file.path(candidatos, marcador))]
if (!length(encontrados)) {
stop(
"No se encontró la raíz del proyecto. Abra el proyecto desde su carpeta raíz ",
"o defina PROYECTO_ANALITICA_DIR con la ruta que contiene ", marcador, "."
)
}
encontrados[1]
}
CARPETA_PROYECTO <- buscar_carpeta_proyecto()
setwd(CARPETA_PROYECTO)
message("Raíz del proyecto: ", CARPETA_PROYECTO)
